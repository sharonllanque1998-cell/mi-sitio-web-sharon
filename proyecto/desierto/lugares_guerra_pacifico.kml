<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Lugares Guerra del Pacífico</name>

    <Placemark>
      <name>Antofagasta</name>
      <description>
        <![CDATA[
          <p>Ciudad clave al inicio de la Guerra del Pacífico.</p>
